{
  "manifest_version": 3,
  "name": "arXiv → alphaXiv",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "description": "Redirect arXiv abs/html/pdf links to alphaXiv, including when Adobe Acrobat is installed.",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://arxiv.org/*",
    "*://www.arxiv.org/*",
    "*://export.arxiv.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirects",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "arXiv → alphaXiv",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
